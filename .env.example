# =====================================================================
# PaperMind AI Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or expose your API keys.
# =====================================================================

# LLM Provider (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1

# Persistence Directories
CHROMA_PERSIST_DIRECTORY=data/storage/chroma
BM25_PERSIST_DIRECTORY=data/storage/bm25
UPLOAD_DIRECTORY=data/uploads

# Embedding & Reranking Models (SentenceTransformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Retrieval & Hybrid Search Parameters
SEMANTIC_TOP_K=15
BM25_TOP_K=15
RRF_K=60
RERANK_TOP_K=5

# Safety & Upload Constraints
MAX_UPLOAD_SIZE_MB=25
